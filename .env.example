# ==========================================================
# InfoVelocity - Hacker News Collector Configuration
# ==========================================================

# 1. Discovery & Polling Configuration
# Number of newest stories to discover per polling cycle (default: 25)
POSTS_PER_POLL=25

# Polling interval in seconds between cycles (default: 300)
POLL_INTERVAL_SECONDS=300

# Immutable catalog file for first-seen story records
OUTPUT_FILE=hn_events.jsonl

# Periodic snapshot file for time-series engagement velocity tracking
SNAPSHOT_FILE=hn_snapshots.jsonl

# 2. Active Tracking Pool Configuration
# Maximum number of stories to actively track and snapshot simultaneously
ACTIVE_STORY_LIMIT=100

# Maximum age in hours for a story to remain in the active tracking pool
ACTIVE_WINDOW_HOURS=12

# 3. Logging
LOG_FILE=collector.log
